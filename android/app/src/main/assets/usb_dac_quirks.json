{
  "version": 2,
  "vendors": [
    {
      "match": { "vid": "0x262a", "label": "iBasso / SAVITECH" },
      "devices": [
        {
          "match": { "pid": "0x1a0b", "label": "iBasso Macaron" },
          "clock": {
            "preRollMs": 250
          },
          "hardwareVolume": {
            "enabled": true,
            "protocol": "ibassoHid",
            "dsdSupported": true
          }
        }
      ]
    }
  ]
}
